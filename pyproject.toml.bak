[project]
name = "pglp-rl"
version = "0.1.0"
description = "SB3-based implementation for Scalable Pyramid and PGLP intrinsic motivation"
readme = "README.md"
requires-python = ">=3.10,<3.14"
dependencies = [
    "torch>=2.3,<3.0",
    "stable-baselines3[extra]>=2.8.0,<3.0",
    "numpy>=1.26,<3.0",
    "pandas>=2.2,<3.0",
    "matplotlib>=3.8,<4.0",
    "pyyaml>=6.0,<7.0",
    "tqdm>=4.66,<5.0",
]

[dependency-groups]
dev = [
    "pytest>=8.0,<9.0",
    "black>=25.0,<26.0",
    "ruff>=0.11,<0.12",
    "mypy>=1.15,<2.0",
]

[build-system]
requires = ["hatchling>=1.27.0"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/pglp_rl"]

[tool.black]
line-length = 100

[tool.ruff]
line-length = 100
target-version = "py310"

[tool.ruff.lint]
select = ["E", "F", "I", "B"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]